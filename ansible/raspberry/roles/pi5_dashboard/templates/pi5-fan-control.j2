#!/bin/sh
set -eu

# This dashboard controls the single PWM fan registered by the Pi 5 overlay.
fan=
for device in /sys/class/thermal/cooling_device*; do
    [ -r "$device/type" ] || continue
    [ "$(cat "$device/type")" = pwm-fan ] || continue
    [ -z "$fan" ] || exit 1
    fan=$device
done
[ -n "$fan" ] || exit 1

case "${1:-}" in
    on)
        state=$(cat "$fan/max_state")
        ;;
    off)
        state=0
        ;;
    *)
        exit 1
        ;;
esac
printf '%s\n' "$state" > "$fan/cur_state"

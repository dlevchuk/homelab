ctrl_interface=DIR=/var/run/wpa_supplicant GROUP=netdev
update_config=1
country=UA

{% for net in wifi_networks %}
network={
    ssid="{{ net.ssid }}"
{% if net.psk | default('') | length > 0 %}
    psk="{{ net.psk }}"
    key_mgmt=WPA-PSK
{% else %}
    key_mgmt=NONE
{% endif %}
    priority={{ wifi_client_priority }}
{% if net.hidden | default(false) %}
    scan_ssid=1
{% endif %}
}

{% endfor %}

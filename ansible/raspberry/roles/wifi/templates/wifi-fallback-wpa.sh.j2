#!/bin/bash
# Wi-Fi fallback manager (wpa_supplicant backend): switches to AP mode when
# neither Ethernet nor client Wi-Fi is available.
# Managed by Ansible role 'wifi' — DO NOT EDIT BY HAND.

set -u

LOGGER="/usr/bin/logger -t wifi-fallback"
IW="$(command -v iw 2>/dev/null || echo /sbin/iw)"
WPA_CLI="$(command -v wpa_cli 2>/dev/null || echo /sbin/wpa_cli)"
IP="$(command -v ip 2>/dev/null || echo /sbin/ip)"
WLAN_IF="{{ wifi_interface }}"
AP_SSID="{{ wifi_ap_ssid }}"
AP_PASSWORD="{{ wifi_ap_password }}"
AP_IP="{{ wifi_ap_ip }}"
AP_IP_ADDR="{{ wifi_ap_ip.split('/')[0] }}"
AP_IP_PREFIX="{{ wifi_ap_ip }}"
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
DNSMASQ_CONF="/etc/dnsmasq-ap.conf"
DNSMASQ_PID="/run/dnsmasq-ap.pid"
BOOT_GRACE_SEC=180
AP_RETRY_INTERVAL_SEC=300
PROBE_FILE="/run/wifi-fallback-ap-probe"

log() {
    $LOGGER "$1"
}

# ---------------------------------------------------------------------------
# Guard: wlan interface must exist
# ---------------------------------------------------------------------------
if [ ! -d "/sys/class/net/$WLAN_IF" ]; then
    log "Interface $WLAN_IF not found, exiting."
    exit 0
fi

# ---------------------------------------------------------------------------
# Helper: is Ethernet connected (carrier + IP)?
# ---------------------------------------------------------------------------
is_ethernet_connected() {
    for iface in /sys/class/net/eth* /sys/class/net/end* /sys/class/net/en*; do
        [ -e "$iface" ] || continue
        if [ "$(cat "$iface/carrier" 2>/dev/null)" = "1" ] && \
           [ "$(cat "$iface/operstate" 2>/dev/null)" = "up" ]; then
            local devname
            devname=$(basename "$iface")
            if $IP -4 addr show dev "$devname" 2>/dev/null | grep -q "inet "; then
                return 0
            fi
        fi
    done
    return 1
}

# ---------------------------------------------------------------------------
# Helper: is wlan0 in AP mode right now?
# ---------------------------------------------------------------------------
is_ap_mode() {
    $IW dev "$WLAN_IF" info 2>/dev/null | grep -q "type AP"
}

# ---------------------------------------------------------------------------
# Helper: does wlan0 have a routable IP (client connected)?
# ---------------------------------------------------------------------------
is_client_connected() {
    # wpa_state=COMPLETED and interface has an IP address
    if $WPA_CLI -i "$WLAN_IF" status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
        if $IP -4 addr show dev "$WLAN_IF" 2>/dev/null | grep -q "inet "; then
            return 0
        fi
    fi
    return 1
}

# ---------------------------------------------------------------------------
# Helper: count stations associated to our AP
# ---------------------------------------------------------------------------
get_ap_client_count() {
    $IW dev "$WLAN_IF" station dump 2>/dev/null | grep -c "^Station" || echo 0
}

# ---------------------------------------------------------------------------
# Stop AP: bring down hostapd + dnsmasq-ap, flush IP, restore managed mode
# ---------------------------------------------------------------------------
stop_ap() {
    log "Stopping fallback AP..."

    # Stop hostapd
    systemctl stop hostapd 2>/dev/null || true
    # Also kill any stray hostapd we might have launched directly
    local hostapd_pid
    hostapd_pid=$(cat /run/hostapd.pid 2>/dev/null || true)
    if [ -n "$hostapd_pid" ] && kill -0 "$hostapd_pid" 2>/dev/null; then
        kill "$hostapd_pid" 2>/dev/null || true
        sleep 1
    fi

    # Stop dnsmasq-ap
    local dnsmasq_pid
    dnsmasq_pid=$(cat "$DNSMASQ_PID" 2>/dev/null || true)
    if [ -n "$dnsmasq_pid" ] && kill -0 "$dnsmasq_pid" 2>/dev/null; then
        kill "$dnsmasq_pid" 2>/dev/null || true
    fi
    rm -f "$DNSMASQ_PID"

    # Remove AP IP and reset interface
    $IP addr flush dev "$WLAN_IF" 2>/dev/null || true
    $IP link set "$WLAN_IF" down 2>/dev/null || true
    sleep 1
    $IP link set "$WLAN_IF" up 2>/dev/null || true

    # wpa_supplicant and dhcpcd are services — they will reconnect automatically
    log "AP stopped; wpa_supplicant/dhcpcd will attempt client reconnect."
}

# ---------------------------------------------------------------------------
# Start AP: launch hostapd (it sets interface mode), set static IP, dnsmasq
# ---------------------------------------------------------------------------
start_ap() {
    log "Starting fallback AP (SSID: $AP_SSID)..."

    # Ensure interface is down before hostapd configures it
    $IP link set "$WLAN_IF" down 2>/dev/null || true
    sleep 1

    # Unmask hostapd temporarily and start it (we masked autostart, not manual)
    systemctl start hostapd 2>/dev/null || {
        log "ERROR: systemctl start hostapd failed; check $HOSTAPD_CONF"
        return 1
    }

    sleep 2  # give hostapd time to configure the interface

    # Assign static AP IP
    $IP addr flush dev "$WLAN_IF" 2>/dev/null || true
    $IP addr add "$AP_IP_PREFIX" dev "$WLAN_IF" 2>/dev/null || true
    $IP link set "$WLAN_IF" up 2>/dev/null || true

    # Start dnsmasq for AP DHCP/DNS (separate from system dnsmasq)
    if [ -f "$DNSMASQ_PID" ] && kill -0 "$(cat "$DNSMASQ_PID" 2>/dev/null)" 2>/dev/null; then
        log "dnsmasq-ap already running."
    else
        rm -f "$DNSMASQ_PID"
        /usr/sbin/dnsmasq --conf-file="$DNSMASQ_CONF" --pid-file="$DNSMASQ_PID" 2>/dev/null || {
            log "WARNING: dnsmasq failed to start; DHCP will not work in AP mode."
        }
    fi

    # Enable IP forwarding and NAT if any Ethernet interface is up
    local eth_if=""
    for iface in /sys/class/net/eth* /sys/class/net/end* /sys/class/net/en*; do
        [ -e "$iface" ] || continue
        if [ "$(cat "$iface/operstate" 2>/dev/null)" = "up" ]; then
            eth_if=$(basename "$iface")
            break
        fi
    done

    if [ -n "$eth_if" ]; then
        echo 1 > /proc/sys/net/ipv4/ip_forward
        iptables -t nat -C POSTROUTING -o "$eth_if" -j MASQUERADE 2>/dev/null || \
            iptables -t nat -A POSTROUTING -o "$eth_if" -j MASQUERADE 2>/dev/null || true
        log "NAT enabled via $eth_if."
    fi

    log "Fallback AP started (SSID: $AP_SSID, IP: $AP_IP_ADDR)."
    date +%s > "$PROBE_FILE"
    return 0
}

# ---------------------------------------------------------------------------
# Try connecting to known wpa_supplicant client networks
# Returns 0 if a network reaches COMPLETED within timeout, 1 otherwise
# ---------------------------------------------------------------------------
try_client_networks() {
    log "Scanning for known client Wi-Fi networks..."

    # Trigger a fresh scan
    $WPA_CLI -i "$WLAN_IF" scan > /dev/null 2>&1 || true
    sleep 3

    # Retrieve scan results (SSIDs)
    local scan_ssids
    scan_ssids=$($WPA_CLI -i "$WLAN_IF" scan_results 2>/dev/null | awk 'NR>1 && NF>=5 {$1=$2=$3=$4=""; sub(/^[[:space:]]+/,"",$0); print}' || true)

    # Get list of configured network IDs and their SSIDs
    local net_list
    net_list=$($WPA_CLI -i "$WLAN_IF" list_networks 2>/dev/null | awk 'NR>1 && NF>=2 {print $1, $2}' || true)
    [ -z "$net_list" ] && return 1

    # First pass: visible networks
    local net_id net_ssid
    while IFS=' ' read -r net_id net_ssid; do
        [ -z "$net_id" ] && continue
        if echo "$scan_ssids" | grep -Fxq "$net_ssid" 2>/dev/null; then
            log "Trying visible network id=$net_id SSID=$net_ssid ..."
            $WPA_CLI -i "$WLAN_IF" select_network "$net_id" > /dev/null 2>&1 || true
            $WPA_CLI -i "$WLAN_IF" reassoc > /dev/null 2>&1 || true
            local waited=0
            while [ $waited -lt 12 ]; do
                sleep 1
                waited=$((waited + 1))
                if $WPA_CLI -i "$WLAN_IF" status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
                    log "Connected to SSID=$net_ssid (id=$net_id)."
                    return 0
                fi
            done
            log "Timed out waiting for SSID=$net_ssid."
        fi
    done <<< "$net_list"

    # Second pass: hidden / not-visible networks
    while IFS=' ' read -r net_id net_ssid; do
        [ -z "$net_id" ] && continue
        if ! echo "$scan_ssids" | grep -Fxq "$net_ssid" 2>/dev/null; then
            log "Trying hidden/unscanned network id=$net_id SSID=$net_ssid ..."
            $WPA_CLI -i "$WLAN_IF" select_network "$net_id" > /dev/null 2>&1 || true
            $WPA_CLI -i "$WLAN_IF" reassoc > /dev/null 2>&1 || true
            local waited=0
            while [ $waited -lt 12 ]; do
                sleep 1
                waited=$((waited + 1))
                if $WPA_CLI -i "$WLAN_IF" status 2>/dev/null | grep -q "wpa_state=COMPLETED"; then
                    log "Connected to SSID=$net_ssid (id=$net_id)."
                    return 0
                fi
            done
        fi
    done <<< "$net_list"

    return 1
}

# ===========================================================================
# MAIN EXECUTION FLOW
# ===========================================================================

# Case A: Ethernet is connected → stop AP if running, exit
if is_ethernet_connected; then
    if is_ap_mode; then
        log "Ethernet connected. Stopping fallback AP..."
        stop_ap
        rm -f "$PROBE_FILE"
    fi
    exit 0
fi

# Case B: wlan0 has IP and is NOT in AP mode → client connected, nothing to do
if ! is_ap_mode && is_client_connected; then
    rm -f "$PROBE_FILE"
    exit 0
fi

# Case C: wlan0 is currently in AP mode
if is_ap_mode; then
    CLIENT_COUNT=$(get_ap_client_count)
    if [ "$CLIENT_COUNT" -gt 0 ]; then
        log "AP active with $CLIENT_COUNT client(s). Not disturbing."
        exit 0
    fi

    NOW=$(date +%s)
    LAST_PROBE=0
    [ -f "$PROBE_FILE" ] && LAST_PROBE=$(cat "$PROBE_FILE" 2>/dev/null || echo 0)

    if [ "$LAST_PROBE" -eq 0 ]; then
        log "AP active with 0 clients — recording probe timestamp."
        echo "$NOW" > "$PROBE_FILE"
        exit 0
    fi

    ELAPSED=$((NOW - LAST_PROBE))
    if [ "$ELAPSED" -lt "$AP_RETRY_INTERVAL_SEC" ]; then
        log "AP active, 0 clients, ${ELAPSED}s since probe (< ${AP_RETRY_INTERVAL_SEC}s). Waiting."
        exit 0
    fi

    log "AP active with 0 clients for ${ELAPSED}s. Stopping AP to retry client networks..."
    echo "$NOW" > "$PROBE_FILE"
    stop_ap
    sleep 3

    if try_client_networks; then
        log "Reconnected to client Wi-Fi successfully."
        rm -f "$PROBE_FILE"
        exit 0
    else
        log "Client networks still unreachable. Restoring fallback AP..."
        start_ap
        exit 0
    fi
fi

# Case D: No Ethernet, no client Wi-Fi, no AP — check boot grace period
UPTIME_SEC=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
if [ "$UPTIME_SEC" -lt "$BOOT_GRACE_SEC" ]; then
    log "Uptime ${UPTIME_SEC}s < ${BOOT_GRACE_SEC}s grace period. Waiting for client Wi-Fi..."
    exit 0
fi

# Try known client networks
log "No network connection. Probing known client Wi-Fi networks..."
if try_client_networks; then
    log "Connected to client Wi-Fi."
    rm -f "$PROBE_FILE"
    exit 0
fi

# All client networks failed: start fallback AP
log "No client networks available. Starting fallback AP..."
if ! start_ap; then
    log "ERROR: Failed to start fallback AP."
fi

exit 0

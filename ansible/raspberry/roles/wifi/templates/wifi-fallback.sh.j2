#!/bin/bash
# Wi-Fi fallback manager: switches to AP mode when neither Ethernet nor client Wi-Fi is available.
# Managed by Ansible role 'wifi'.

set -u

LOGGER="/usr/bin/logger -t wifi-fallback"
NMCLI="$(command -v nmcli 2>/dev/null || echo /usr/bin/nmcli)"
IW="$(command -v iw 2>/dev/null || echo /usr/sbin/iw)"
WLAN_IF="{{ wifi_interface }}"
AP_CON_NAME="{{ wifi_ap_conn_name }}"
AP_SSID="{{ wifi_ap_ssid }}"
AP_PASSWORD="{{ wifi_ap_password }}"
AP_IP="{{ wifi_ap_ip }}"
BOOT_GRACE_SEC=180
AP_RETRY_INTERVAL_SEC=300
PROBE_FILE="/run/wifi-fallback-ap-probe"

log() {
    $LOGGER "$1"
}

# Ensure NetworkManager is running and wlan interface exists
if ! systemctl is-active --quiet NetworkManager; then
    exit 0
fi

if [ ! -d "/sys/class/net/$WLAN_IF" ]; then
    exit 0
fi

# 1. Check if Ethernet is connected
# If cable is connected and interface has IP/carrier, hotspot is NOT needed
is_ethernet_connected() {
    if $NMCLI -t -f TYPE,STATE device 2>/dev/null | grep -E '^ethernet:connected$' >/dev/null; then
        return 0
    fi

    for iface in /sys/class/net/eth* /sys/class/net/end* /sys/class/net/en*; do
        [ -e "$iface" ] || continue
        if [ "$(cat "$iface/carrier" 2>/dev/null)" = "1" ] && [ "$(cat "$iface/operstate" 2>/dev/null)" = "up" ]; then
            local devname
            devname=$(basename "$iface")
            if /usr/bin/ip -4 addr show dev "$devname" 2>/dev/null | grep -q "inet "; then
                return 0
            fi
        fi
    done

    return 1
}

# 2. Check if AP mode is currently active on wlan0
is_ap_active() {
    local conn
    conn=$($NMCLI -t -f GENERAL.CONNECTION dev show "$WLAN_IF" 2>/dev/null | head -n 1)
    if [ "$conn" = "$AP_CON_NAME" ]; then
        return 0
    fi
    if [ -x "$IW" ] && $IW dev "$WLAN_IF" info 2>/dev/null | grep -q "type AP"; then
        return 0
    fi
    return 1
}

# 3. Check if wlan0 is connected to a client (infrastructure) Wi-Fi network
is_wifi_client_connected() {
    local state conn
    state=$($NMCLI -t -f GENERAL.STATE dev show "$WLAN_IF" 2>/dev/null | grep -o '^[0-9]\+' || true)
    # State 100 in NetworkManager indicates 'connected'
    if [ "$state" = "100" ]; then
        conn=$($NMCLI -t -f GENERAL.CONNECTION dev show "$WLAN_IF" 2>/dev/null | head -n 1)
        if [ "$conn" != "$AP_CON_NAME" ]; then
            if ! is_ap_active; then
                return 0
            fi
        fi
    fi
    return 1
}

# 4. Count connected client stations to AP
get_ap_client_count() {
    if [ -x "$IW" ]; then
        $IW dev "$WLAN_IF" station dump 2>/dev/null | grep -c '^Station' || echo 0
    else
        echo 0
    fi
}

# 5. Ensure the AP connection profile exists in NetworkManager
ensure_ap_profile() {
    if ! $NMCLI connection show id "$AP_CON_NAME" >/dev/null 2>&1; then
        if [ -z "$AP_PASSWORD" ]; then
            log "WIFI_AP_PASSWORD not provided. Cannot create AP profile."
            return 1
        fi
        log "AP profile '$AP_CON_NAME' missing. Creating it..."
        $NMCLI connection add \
            type wifi \
            ifname "$WLAN_IF" \
            con-name "$AP_CON_NAME" \
            autoconnect no \
            ssid "$AP_SSID" \
            mode ap \
            802-11-wireless.band bg \
            802-11-wireless-security.key-mgmt wpa-psk \
            802-11-wireless-security.psk "$AP_PASSWORD" \
            ipv4.method shared \
            ipv4.addresses "$AP_IP" \
            ipv6.method disabled >/dev/null 2>&1 || true
    fi
}

# 6. Try connecting to known client Wi-Fi networks
try_client_networks() {
    $NMCLI device wifi rescan >/dev/null 2>&1 || true
    sleep 2

    local conns
    conns=$($NMCLI -g NAME,TYPE connection show 2>/dev/null | awk -F: -v ap="$AP_CON_NAME" '($2=="802-11-wireless" || $2=="wifi") && $1!=ap {print $1}')
    [ -z "$conns" ] && return 1

    local visible_ssids
    visible_ssids=$($NMCLI -g SSID device wifi list 2>/dev/null | grep -v '^--$' | grep -v '^$' | sort -u || true)

    # First pass: visible networks
    while IFS= read -r conn; do
        [ -z "$conn" ] && continue
        local ssid
        ssid=$($NMCLI -g 802-11-wireless.ssid connection show "$conn" 2>/dev/null || echo "$conn")
        if echo "$visible_ssids" | grep -Fxq "$ssid"; then
            log "Attempting connection to visible network '$conn' (SSID: $ssid)..."
            if $NMCLI --wait 10 connection up id "$conn" >/dev/null 2>&1; then
                log "Successfully connected to '$conn'"
                return 0
            fi
        fi
    done <<< "$conns"

    # Second pass: hidden or unscanned networks
    while IFS= read -r conn; do
        [ -z "$conn" ] && continue
        local ssid
        ssid=$($NMCLI -g 802-11-wireless.ssid connection show "$conn" 2>/dev/null || echo "$conn")
        if ! echo "$visible_ssids" | grep -Fxq "$ssid"; then
            log "Attempting connection to network '$conn' (SSID: $ssid)..."
            if $NMCLI --wait 10 connection up id "$conn" >/dev/null 2>&1; then
                log "Successfully connected to '$conn'"
                return 0
            fi
        fi
    done <<< "$conns"

    return 1
}

# --- MAIN EXECUTION FLOW ---

# Case A: Ethernet is connected
if is_ethernet_connected; then
    if is_ap_active; then
        log "Ethernet connected. Stopping fallback AP..."
        $NMCLI connection down id "$AP_CON_NAME" >/dev/null 2>&1 || true
        rm -f "$PROBE_FILE"
    fi
    exit 0
fi

# Case B: Wi-Fi client is connected
if is_wifi_client_connected; then
    # wlan0 connected to client network -> nothing to do
    rm -f "$PROBE_FILE"
    exit 0
fi

# Case C: Fallback AP is currently active
if is_ap_active; then
    CLIENT_COUNT=$(get_ap_client_count)
    if [ "$CLIENT_COUNT" -gt 0 ]; then
        # Client(s) connected to AP: do not disturb!
        exit 0
    fi

    # No clients connected: check if ~5 minutes passed since last probe
    NOW=$(date +%s)
    LAST_PROBE=0
    [ -f "$PROBE_FILE" ] && LAST_PROBE=$(cat "$PROBE_FILE" 2>/dev/null || echo 0)

    if [ "$LAST_PROBE" -eq 0 ]; then
        echo "$NOW" > "$PROBE_FILE"
        exit 0
    fi

    ELAPSED=$((NOW - LAST_PROBE))
    if [ "$ELAPSED" -lt "$AP_RETRY_INTERVAL_SEC" ]; then
        exit 0
    fi

    # 5 minutes elapsed without clients: bring down AP and try client networks
    log "AP active with 0 clients for ${ELAPSED}s. Stopping AP to retry client Wi-Fi..."
    echo "$NOW" > "$PROBE_FILE"
    $NMCLI connection down id "$AP_CON_NAME" >/dev/null 2>&1 || true
    sleep 2

    if try_client_networks; then
        log "Reconnected to client Wi-Fi successfully."
        rm -f "$PROBE_FILE"
        exit 0
    else
        log "Client networks still unavailable. Restoring AP..."
        ensure_ap_profile
        $NMCLI connection up id "$AP_CON_NAME" >/dev/null 2>&1 || true
        echo "$(date +%s)" > "$PROBE_FILE"
        exit 0
    fi
fi

# Case D: Neither Ethernet, nor client Wi-Fi, nor AP is active
# Check boot grace period (< ~3 minutes)
UPTIME_SEC=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
if [ "$UPTIME_SEC" -lt "$BOOT_GRACE_SEC" ]; then
    log "System uptime ($UPTIME_SEC s) < ${BOOT_GRACE_SEC}s. Waiting for router to boot..."
    exit 0
fi

# Try known client networks
log "No network connection. Probing known client Wi-Fi networks..."
if try_client_networks; then
    log "Connected to client Wi-Fi."
    rm -f "$PROBE_FILE"
    exit 0
fi

# All client networks failed: activate fallback AP
log "Known client Wi-Fi networks unreachable. Starting fallback AP ($AP_CON_NAME)..."
ensure_ap_profile
if $NMCLI connection up id "$AP_CON_NAME" >/dev/null 2>&1; then
    log "Fallback AP started successfully (SSID: $AP_SSID)."
    date +%s > "$PROBE_FILE"
else
    log "ERROR: Failed to start fallback AP ($AP_CON_NAME)."
fi

exit 0


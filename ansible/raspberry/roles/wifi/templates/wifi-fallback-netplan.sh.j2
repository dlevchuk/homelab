#!/bin/bash
# Wi-Fi fallback manager (netplan/networkd backend).
# Uses wpa_supplicant (managed by systemd-networkd/netplan), hostapd, and dnsmasq-base.
# Switches to AP mode when neither Ethernet nor client Wi-Fi is available.
# Managed by Ansible role 'wifi'.

set -u

LOGGER="/usr/bin/logger -t wifi-fallback"
IW="$(command -v iw 2>/dev/null || echo /usr/sbin/iw)"
WPA_CLI="$(command -v wpa_cli 2>/dev/null || echo /usr/sbin/wpa_cli)"
WPA_SOCKET_DIR="/run/wpa_supplicant"
WLAN_IF="{{ wifi_interface }}"
AP_SSID="{{ wifi_ap_ssid }}"
AP_PASSWORD="{{ wifi_ap_password }}"
AP_IP="{{ wifi_ap_ip }}"
AP_IP_ADDR="${AP_IP%%/*}"
HOSTAPD_CONF="/etc/hostapd/hostapd.conf"
HOSTAPD_PID="/run/hostapd.pid"
DNSMASQ_CONF="/etc/dnsmasq-ap.conf"
DNSMASQ_PID="/run/dnsmasq-ap.pid"
BOOT_GRACE_SEC=180
AP_RETRY_INTERVAL_SEC=300
PROBE_FILE="/run/wifi-fallback-ap-probe"

log() {
    $LOGGER "$1"
}

# --- Guard: wlan interface must exist ---
if [ ! -d "/sys/class/net/$WLAN_IF" ]; then
    exit 0
fi

# --- Helper: check if Ethernet is connected (carrier + IP) ---
is_ethernet_connected() {
    for iface in /sys/class/net/eth* /sys/class/net/end* /sys/class/net/en*; do
        [ -e "$iface" ] || continue
        if [ "$(cat "$iface/carrier" 2>/dev/null)" = "1" ] && \
           [ "$(cat "$iface/operstate" 2>/dev/null)" = "up" ]; then
            local devname
            devname=$(basename "$iface")
            if /usr/bin/ip -4 addr show dev "$devname" 2>/dev/null | grep -q "inet "; then
                return 0
            fi
        fi
    done
    return 1
}

# --- Helper: check if wlan0 is connected to a client (infrastructure) network ---
is_wifi_client_connected() {
    # On netplan+networkd, wpa_supplicant manages the wireless association.
    # wpa_state=COMPLETED means successfully associated and authenticated.
    if [ -S "${WPA_SOCKET_DIR}/${WLAN_IF}" ]; then
        if "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" status 2>/dev/null \
               | grep -q "wpa_state=COMPLETED"; then
            return 0
        fi
    fi
    return 1
}

# --- Helper: check if hostapd AP is currently active ---
is_ap_active() {
    # Primary check: hostapd pid file and process alive
    if [ -f "$HOSTAPD_PID" ]; then
        local pid
        pid=$(cat "$HOSTAPD_PID" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            return 0
        fi
    fi
    # Secondary check: iw reports AP mode
    if [ -x "$IW" ] && "$IW" dev "$WLAN_IF" info 2>/dev/null | grep -q "type AP"; then
        return 0
    fi
    return 1
}

# --- Helper: count stations connected to our AP ---
get_ap_client_count() {
    if [ -x "$IW" ]; then
        "$IW" dev "$WLAN_IF" station dump 2>/dev/null | grep -c '^Station' || echo 0
    else
        echo 0
    fi
}

# --- Helper: stop the fallback AP (hostapd + dnsmasq) ---
stop_ap() {
    log "Stopping fallback AP..."
    if [ -f "$HOSTAPD_PID" ]; then
        local pid
        pid=$(cat "$HOSTAPD_PID" 2>/dev/null)
        if [ -n "$pid" ] && kill -0 "$pid" 2>/dev/null; then
            kill "$pid" 2>/dev/null || true
            sleep 1
        fi
        rm -f "$HOSTAPD_PID"
    fi
    # Kill any remaining hostapd on our interface
    pkill -f "hostapd.*${HOSTAPD_CONF}" 2>/dev/null || true

    if [ -f "$DNSMASQ_PID" ]; then
        local dpid
        dpid=$(cat "$DNSMASQ_PID" 2>/dev/null)
        if [ -n "$dpid" ] && kill -0 "$dpid" 2>/dev/null; then
            kill "$dpid" 2>/dev/null || true
        fi
        rm -f "$DNSMASQ_PID"
    fi
    pkill -f "dnsmasq.*${DNSMASQ_CONF}" 2>/dev/null || true

    # Return interface to managed mode so wpa_supplicant/networkd can use it
    "$IW" dev "$WLAN_IF" set type managed 2>/dev/null || true
    sleep 1
    # Restart systemd-networkd to re-apply netplan config and restart wpa_supplicant
    systemctl restart systemd-networkd 2>/dev/null || true
}

# --- Helper: start the fallback AP (hostapd + dnsmasq + static IP) ---
start_ap() {
    if [ -z "$AP_PASSWORD" ]; then
        log "AP password not set; cannot start fallback AP."
        return 1
    fi

    log "Starting fallback AP (SSID: $AP_SSID)..."

    # Stop networkd/wpa_supplicant interference
    systemctl stop systemd-networkd 2>/dev/null || true
    pkill -x wpa_supplicant 2>/dev/null || true
    sleep 1

    # Put interface in AP mode and assign static IP
    /usr/sbin/ip link set "$WLAN_IF" down 2>/dev/null || true
    "$IW" dev "$WLAN_IF" set type managed 2>/dev/null || true
    /usr/sbin/ip link set "$WLAN_IF" up 2>/dev/null || true
    /usr/sbin/ip addr flush dev "$WLAN_IF" 2>/dev/null || true
    /usr/sbin/ip addr add "$AP_IP" dev "$WLAN_IF" 2>/dev/null || true

    # Start hostapd
    /usr/sbin/hostapd -B -P "$HOSTAPD_PID" "$HOSTAPD_CONF" >/dev/null 2>&1
    sleep 2

    if ! is_ap_active; then
        log "ERROR: hostapd failed to start."
        systemctl start systemd-networkd 2>/dev/null || true
        return 1
    fi

    # Start dnsmasq for DHCP on AP interface
    /usr/sbin/dnsmasq --conf-file="$DNSMASQ_CONF" \
        --pid-file="$DNSMASQ_PID" \
        --interface="$WLAN_IF" \
        --except-interface=lo \
        2>/dev/null || true

    log "Fallback AP started (SSID: $AP_SSID, IP: $AP_IP_ADDR)."
    return 0
}

# --- Helper: attempt connection to configured client networks via wpa_cli ---
try_client_networks() {
    if [ ! -S "${WPA_SOCKET_DIR}/${WLAN_IF}" ]; then
        log "wpa_supplicant socket not found; restarting networkd..."
        systemctl restart systemd-networkd 2>/dev/null || true
        sleep 5
    fi

    if [ ! -S "${WPA_SOCKET_DIR}/${WLAN_IF}" ]; then
        log "wpa_supplicant still unavailable; cannot try client networks."
        return 1
    fi

    log "Scanning for known networks..."
    "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" scan >/dev/null 2>&1 || true
    sleep 4

    local scan_results
    scan_results=$("$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" scan_results 2>/dev/null || true)

    local network_ids
    network_ids=$("$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" list_networks 2>/dev/null \
        | awk 'NR>1 {print $1}')

    if [ -z "$network_ids" ]; then
        log "No networks configured in wpa_supplicant."
        return 1
    fi

    # First pass: visible SSIDs
    while IFS= read -r net_id; do
        [ -z "$net_id" ] && continue
        local ssid
        ssid=$("$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" get_network "$net_id" ssid 2>/dev/null \
            | tr -d '"')
        if echo "$scan_results" | grep -qF "$ssid"; then
            log "Trying visible network id=$net_id SSID=$ssid..."
            "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" select_network "$net_id" >/dev/null 2>&1 || true
            "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" reassociate >/dev/null 2>&1 || true
            local deadline=$(( $(date +%s) + 15 ))
            while [ "$(date +%s)" -lt "$deadline" ]; do
                if "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" status 2>/dev/null \
                        | grep -q "wpa_state=COMPLETED"; then
                    log "Connected to SSID=$ssid."
                    return 0
                fi
                sleep 2
            done
            log "Timed out connecting to SSID=$ssid."
        fi
    done <<< "$network_ids"

    # Second pass: hidden / not visible networks
    while IFS= read -r net_id; do
        [ -z "$net_id" ] && continue
        local ssid
        ssid=$("$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" get_network "$net_id" ssid 2>/dev/null \
            | tr -d '"')
        if ! echo "$scan_results" | grep -qF "$ssid"; then
            log "Trying non-visible network id=$net_id SSID=$ssid..."
            "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" select_network "$net_id" >/dev/null 2>&1 || true
            "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" reassociate >/dev/null 2>&1 || true
            local deadline=$(( $(date +%s) + 20 ))
            while [ "$(date +%s)" -lt "$deadline" ]; do
                if "$WPA_CLI" -p "$WPA_SOCKET_DIR" -i "$WLAN_IF" status 2>/dev/null \
                        | grep -q "wpa_state=COMPLETED"; then
                    log "Connected to SSID=$ssid."
                    return 0
                fi
                sleep 2
            done
            log "Timed out connecting to SSID=$ssid."
        fi
    done <<< "$network_ids"

    return 1
}

# =============================================================================
# MAIN EXECUTION FLOW
# =============================================================================

# Case A: Ethernet connected → ensure AP is not running, exit
if is_ethernet_connected; then
    if is_ap_active; then
        log "Ethernet connected. Stopping fallback AP..."
        stop_ap
        rm -f "$PROBE_FILE"
    fi
    exit 0
fi

# Case B: Wi-Fi client connected → nothing to do
if is_wifi_client_connected; then
    rm -f "$PROBE_FILE"
    exit 0
fi

# Case C: Fallback AP is currently active
if is_ap_active; then
    CLIENT_COUNT=$(get_ap_client_count)
    if [ "$CLIENT_COUNT" -gt 0 ]; then
        # Device(s) connected to AP — do not disturb
        exit 0
    fi

    # No clients: check if the retry interval has elapsed
    NOW=$(date +%s)
    LAST_PROBE=0
    [ -f "$PROBE_FILE" ] && LAST_PROBE=$(cat "$PROBE_FILE" 2>/dev/null || echo 0)

    if [ "$LAST_PROBE" -eq 0 ]; then
        # First check since AP started — record timestamp and wait
        echo "$NOW" > "$PROBE_FILE"
        exit 0
    fi

    ELAPSED=$(( NOW - LAST_PROBE ))
    if [ "$ELAPSED" -lt "$AP_RETRY_INTERVAL_SEC" ]; then
        exit 0
    fi

    # Retry interval elapsed with no clients: stop AP, try client networks
    log "AP active with 0 clients for ${ELAPSED}s. Stopping AP to retry client Wi-Fi..."
    echo "$NOW" > "$PROBE_FILE"
    stop_ap
    sleep 3

    if try_client_networks; then
        log "Reconnected to client Wi-Fi successfully."
        rm -f "$PROBE_FILE"
        exit 0
    else
        log "Client networks still unavailable. Restoring AP..."
        if start_ap; then
            echo "$(date +%s)" > "$PROBE_FILE"
        fi
        exit 0
    fi
fi

# Case D: No Ethernet, no client Wi-Fi, no AP active
# Respect boot grace period (~3 minutes) to let the router come up
UPTIME_SEC=$(awk '{print int($1)}' /proc/uptime 2>/dev/null || echo 0)
if [ "$UPTIME_SEC" -lt "$BOOT_GRACE_SEC" ]; then
    log "Uptime ${UPTIME_SEC}s < ${BOOT_GRACE_SEC}s grace period. Waiting..."
    exit 0
fi

# Try known client Wi-Fi networks
log "No network. Probing known client Wi-Fi networks..."
if try_client_networks; then
    log "Connected to client Wi-Fi."
    rm -f "$PROBE_FILE"
    exit 0
fi

# All client networks failed: start fallback AP
log "No client Wi-Fi available. Starting fallback AP..."
if start_ap; then
    log "Fallback AP active (SSID: $AP_SSID)."
    date +%s > "$PROBE_FILE"
else
    log "ERROR: Failed to start fallback AP."
fi

exit 0

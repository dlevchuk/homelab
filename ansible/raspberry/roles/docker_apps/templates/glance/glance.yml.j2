# Generated by Ansible. Services and bookmarks share Homepage's definitions.
server:
  port: 8080
branding:
  app-name: {{ homepage_title | to_json }}
  logo-text: PI
theme:
  background-color: {{ glance_background_color }}
  primary-color: {{ glance_primary_color }}
  positive-color: {{ glance_positive_color }}
  negative-color: 0 65 70
  contrast-multiplier: 1.15
  text-saturation-multiplier: 0.6
pages:
  - name: Pi 5
    columns:
      - size: small
        widgets:
          - type: clock
            hour-format: 24h
            timezones:
              - timezone: Europe/Kyiv
                label: Kyiv
          - type: weather
            location: Odesa, Ukraine
            units: metric
            hour-format: 24h
          - type: server-stats
            title: Raspberry Pi
            servers:
              - type: local
                name: {{ homepage_title | to_json }}
                hide-mountpoints-by-default: true
                mountpoints:
                  /host/root:
                    name: Root
                    hide: false
          - type: calendar
            first-day-of-week: monday
      - size: full
        widgets:
          - type: search
            search-engine: google
            autofocus: false
{% for section in glance_services %}
{% for group, services in section.items() %}
{% set ns = namespace(linked=[]) %}
{% for entry in services %}
{% for name, service in entry.items() %}
{% if service.href is defined %}
{% set ns.linked = ns.linked + [entry] %}
{% endif %}
{% endfor %}
{% endfor %}
{% if ns.linked %}
          - type: monitor
            title: {{ group | to_json }}
            cache: 1m
            sites:
{% for entry in ns.linked %}
{% for name, service in entry.items() %}
              - title: {{ name | to_json }}
                url: {{ service.href | to_json }}
                icon: {{ ('di:' ~ service.icon) if not service.icon.startswith('mdi-') else ('mdi:' ~ service.icon[4:]) }}
{% if service.container | default('') == 'hermes' %}
                check-url: http://hermes:9120/
{% elif service.siteMonitor is defined %}
                check-url: {{ service.siteMonitor | to_json }}
{% endif %}
{% endfor %}
{% endfor %}
{% endif %}
{% endfor %}
{% endfor %}
          - type: docker-containers
            title: Docker · Pi 5
            hide-by-default: false
            containers:
{% for section in glance_services %}
{% for group, services in section.items() %}
{% for entry in services %}
{% for name, service in entry.items() %}
{% if service.container is defined %}
              {{ service.container }}:
                name: {{ name | to_json }}
                description: {{ service.description | to_json }}
                icon: {{ ('di:' ~ service.icon) if not service.icon.startswith('mdi-') else ('mdi:' ~ service.icon[4:]) }}
{% if service.href is defined %}
                url: {{ service.href | to_json }}
{% endif %}
{% endif %}
{% endfor %}
{% endfor %}
{% endfor %}
{% endfor %}
      - size: small
        widgets:
          - type: bookmarks
            title: Закладки
            groups:
{% for section in glance_bookmarks %}
{% for group, links in section.items() %}
              - title: {{ group | to_json }}
                links:
{% for entry in links %}
{% for name, items in entry.items() %}
                  - title: {{ name | to_json }}
                    url: {{ items[0].href | to_json }}
{% endfor %}
{% endfor %}
{% endfor %}
{% endfor %}
          - type: releases
            title: Оновлення
            cache: 6h
            collapse-after: 4
            repositories:
{% for repository in glance_repositories %}
              - {{ repository }}
{% endfor %}
          - type: to-do
            title: Справи
            id: pi5-maintenance
